# Скопируй этот файл в .env и впиши свои значения. Файл .env НЕЛЬЗЯ коммитить в Git.

# Токен от @BotFather (Telegram -> @BotFather -> /newbot)
BOT_TOKEN=

# Необязательно. Где лежит база (по умолчанию tasks.db рядом с bot.py)
# DB_PATH=tasks.db

# Необязательно. Часовой пояс для новых пользователей (каждый может сменить его командой /tz)
# DEFAULT_TZ=Europe/Berlin
